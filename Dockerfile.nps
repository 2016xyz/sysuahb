FROM golang:1.26-alpine AS builder

ARG GOPROXY=https://proxy.golang.org,direct
ENV GOPROXY=${GOPROXY}

WORKDIR /build

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 go build -trimpath -ldflags "-s -w" -o /sysuahb ./cmd/nps/nps.go

FROM alpine:3.22

RUN apk add --no-cache ca-certificates tzdata && update-ca-certificates

COPY --from=builder /sysuahb /sysuahb
COPY web/static /web/static
COPY web/views /web/views
COPY install.sh /web/static/install.sh
COPY conf/sysuahb.conf /sysuahb.conf.sample
COPY entrypoint.nps.sh /entrypoint.sh

RUN chmod +x /sysuahb /entrypoint.sh && mkdir -p /conf

VOLUME /conf

EXPOSE 80 443 6000 8024 8025 8026 8027 8081

ENTRYPOINT ["/entrypoint.sh"]
