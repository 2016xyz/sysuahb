FROM golang:1.26-alpine AS builder

ARG GOPROXY=https://proxy.golang.org,direct
ENV GOPROXY=${GOPROXY}

WORKDIR /build

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 go build -trimpath -ldflags "-s -w" -o /sysficb ./cmd/npc/client.go

FROM alpine:3.22

RUN apk add --no-cache ca-certificates tzdata && update-ca-certificates

COPY --from=builder /sysficb /sysficb

RUN chmod +x /sysficb && mkdir -p /conf

VOLUME /conf

ENTRYPOINT ["/sysficb"]
